PORT=4000
# Optional. When these are missing, or MySQL cannot be reached, the API serves backend/data/store.json.
# On Vercel, leave MYSQL_HOST unset unless a real database is attached to the backend service.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kidlo
JWT_SECRET=change-this-secret
# Set to 1 to force the JSON store even when MySQL is running
MYSQL_DISABLED=0

# Optional Google marketing (merged with Admin → Google Console when those fields are empty)
GOOGLE_SITE_VERIFICATION=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_PREFER_GTM=0
